---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeSection from '../../components/home/HomeSection.astro';
import QuickLook from '../../components/QuickLook.astro';
import TimelineItem from '../../components/home/TimelineItem.astro';
import RobotScene from '../../components/RobotScene.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE } from '../../consts';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export const getStaticPaths = () => [
  { params: { lang: 'en' } },
  { params: { lang: 'zh' } },
];

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const byOrder = (a: any, b: any) => a.data.order - b.data.order;
const inLang = (id: string) => id.startsWith(lang + '/');

const education = (await getCollection('education')).filter((i) => inLang(i.id)).sort(byOrder);
const projects = (await getCollection('research')).filter((i) => inLang(i.id)).sort(byOrder).slice(0, 3);
const cover = (await getCollection('photography')).filter((p) => inLang(p.id) && p.data.cover).sort(byOrder)[0];
const latestNote = (await getCollection('notes'))
  .filter((n) => inLang(n.id) && !n.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

const tagline = lang === 'zh' ? SITE.taglineZh : SITE.taglineEn;
const aboutLead =
  lang === 'zh'
    ? '我研究机器人学习——机器人如何通过交互积累经验，并借助记忆、可塑性与持续学习，持续适应新的环境、物体与任务。我也摄影，并在独立乐队「巧克力文件岛」打鼓。'
    : 'I work on robot learning — how robots accumulate experience through interaction and keep adapting to new environments, objects, and tasks through memory, plasticity, and continual learning. I also photograph and play drums in the indie band Chocland.doc.';
---

<BaseLayout title={`${lang === 'zh' ? SITE.authorZh : SITE.author} · ${tagline}`} description={tagline} lang={lang}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-text">
      <p class="hero-eyebrow" data-hero style="--d:0ms">
        {lang === 'zh' ? SITE.roleZh : SITE.roleEn}
      </p>
      <h1 class="hero-name" data-hero style="--d:80ms">
        <span class:list={['name-primary', { 'is-cjk': lang === 'zh' }]}>
          {lang === 'zh' ? SITE.authorZh : SITE.author}
        </span>
      </h1>
      <p class:list={['hero-name-alt', { 'is-cjk': lang !== 'zh' }]} data-hero style="--d:160ms">
        {lang === 'zh' ? SITE.author : SITE.authorZh}
      </p>
      <blockquote class="hero-epigraph" data-hero style="--d:280ms">
        <em>“{SITE.epigraph}”</em>
        {lang === 'zh' && <cite>{SITE.epigraphZh}</cite>}
      </blockquote>
      <p class="cta" data-hero style="--d:480ms">
        <a class="btn" href={getRelativeLocaleUrl(lang, 'about')}>{t.nav.about} →</a>
        <a class="btn secondary" href={getRelativeLocaleUrl(lang, 'cv')}>{t.cvTitle}</a>
      </p>
    </div>
    <div class="hero-robot">
      <RobotScene lang={lang} />
    </div>
  </section>

  <div class="home-layout">
  <QuickLook lang={lang} />
  <div class="home-main">
  <!-- ============ 01 About ============ -->
  <HomeSection index="01" title={t.sections.about} id="about">
    <p class="about-lead">{aboutLead}</p>
    <a class="text-link" href={getRelativeLocaleUrl(lang, 'about')}>{t.readMore} →</a>
  </HomeSection>

  <!-- ============ 02 Education ============ -->
  {education.length > 0 && (
    <HomeSection index="02" title={t.sections.education} id="education">
      {education.map((e) => (
        <TimelineItem period={e.data.period} title={e.data.degree} subtitle={e.data.school} details={e.data.details} />
      ))}
    </HomeSection>
  )}

  <!-- ============ 03 Projects ============ -->
  {projects.length > 0 && (
    <HomeSection index="03" title={t.sections.projects} id="projects">
      <div class="proj-list">
        {projects.map((p) => (
          <article class="proj">
            <h3>{p.data.title}</h3>
            <p class="proj-meta">{p.data.role} · {p.data.period}</p>
            <p class="proj-sum">{p.data.summary}</p>
            <div class="proj-foot">
              {p.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              <span class="proj-links">
                {p.data.links.code && <a href={p.data.links.code} target="_blank" rel="noopener">Code</a>}
                {p.data.links.paper && <a href={p.data.links.paper} target="_blank" rel="noopener">Paper</a>}
                {p.data.links.demo && <a href={p.data.links.demo} target="_blank" rel="noopener">Demo</a>}
              </span>
            </div>
          </article>
        ))}
      </div>
      <a class="text-link" href={getRelativeLocaleUrl(lang, 'research')}>{t.viewAll} →</a>
    </HomeSection>
  )}

  <!-- ============ 04 Beyond work ============ -->
  <HomeSection index="04" title={t.sections.beyond} id="beyond">
    <div class="beyond-grid">
      <a class="beyond-card" href={getRelativeLocaleUrl(lang, 'photography')}>
        {cover && <img src={cover.data.image} alt={cover.data.title} loading="lazy" />}
        <span class="beyond-label">{t.nav.photography}</span>
      </a>
      <div class="beyond-card beyond-band">
        <a class="beyond-band-link" href={getRelativeLocaleUrl(lang, 'music')}>
          <span class="beyond-band-name">{lang === 'zh' ? SITE.band.name : SITE.band.nameEn}</span>
          <span class="beyond-label">{t.nav.music} · {lang === 'zh' ? SITE.band.roleZh : SITE.band.roleEn}</span>
        </a>
        <div class="band-streams">
          <a href={SITE.band.netease} target="_blank" rel="noopener">NetEase</a>
          <a href={SITE.band.spotify} target="_blank" rel="noopener">Spotify</a>
        </div>
      </div>
      {latestNote && (
        <a class="beyond-card" href={getRelativeLocaleUrl(lang, `notes/${latestNote.id.split('/').slice(1).join('/')}`)}>
          <span class="beyond-note-title">{latestNote.data.title}</span>
          <span class="beyond-label">{t.notesTitle}</span>
        </a>
      )}
    </div>
  </HomeSection>
  </div>
  </div>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2rem;
    align-items: center;
    min-height: min(78vh, 640px);
    padding: clamp(2rem, 6vw, 4rem) 0 3rem;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute; inset: -10% -5% auto -5%; height: 120%;
    background: radial-gradient(60% 50% at 20% 20%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 70%);
    pointer-events: none; z-index: -1;
  }
  .hero::after {
    content: '';
    position: absolute; inset: 0; pointer-events: none; z-index: -1; opacity: 0.45;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--text) 6%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--text) 6%, transparent) 1px, transparent 1px);
    background-size: 46px 46px;
    -webkit-mask-image: radial-gradient(72% 62% at 50% 40%, #000 26%, transparent 76%);
    mask-image: radial-gradient(72% 62% at 50% 40%, #000 26%, transparent 76%);
  }
  .hero-eyebrow {
    margin: 0 0 1.1rem; font-size: 0.72rem; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--accent-strong); font-weight: 600;
  }
  .hero-name { margin: 0; font-size: var(--fs-hero); line-height: 1.0; letter-spacing: -0.022em; }
  .hero-name .name-primary.is-cjk {
    font-family: 'Noto Serif SC', var(--font-serif);
    letter-spacing: 0.06em; font-weight: 500;
  }
  .hero-name-alt {
    margin: 0.55rem 0 0; font-size: clamp(1.05rem, 2.1vw, 1.4rem);
    color: var(--text-faint); font-family: var(--font-serif);
    letter-spacing: 0.05em; font-weight: 400;
  }
  .hero-name-alt.is-cjk {
    font-family: 'Noto Serif SC', var(--font-serif);
    letter-spacing: 0.4em; font-size: clamp(0.95rem, 1.6vw, 1.15rem);
  }
  .hero-epigraph {
    margin: 0 0 1.6em; padding-left: 1rem;
    border-left: 2px solid var(--accent);
    font-family: var(--font-serif);
  }
  .hero-epigraph em { display: block; font-size: 1.25rem; color: var(--text-muted); }
  .hero-epigraph cite { display: block; margin-top: 0.3em; font-size: var(--fs-small); color: var(--text-faint); font-style: normal; }
  .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; margin: 0; }
  .hero-robot { height: 100%; min-height: 320px; }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .hero-robot { min-height: 280px; order: 2; }
  }

  /* hero 入场动画（非滚动触发） */
  @media (prefers-reduced-motion: no-preference) {
    [data-hero] { opacity: 0; animation: fadeUp 0.8s var(--ease) forwards; animation-delay: var(--d, 0ms); }
  }

  /* ---------- About ---------- */
  .about-lead { font-size: var(--fs-lead); max-width: 62ch; margin: 0 0 0.8em; }
  .text-link { font-weight: 600; font-size: var(--fs-small); }

  /* ---------- Home layout with quick-look rail ---------- */
  .home-layout { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: 3.5rem; align-items: start; padding-top: 1.2rem; }
  .home-main { min-width: 0; }
  @media (max-width: 900px) { .home-layout { grid-template-columns: 1fr; gap: 1.5rem; } }

  /* ---------- Projects ---------- */
  .proj-list { display: grid; gap: 1rem; margin-bottom: 1.2rem; }
  .proj { padding: 1.1rem 1.2rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-elevated); transition: border-color 0.2s var(--ease), transform 0.2s var(--ease); }
  .proj:hover { border-color: var(--accent); transform: translateY(-2px); }
  .proj h3 { margin: 0 0 0.15em; font-size: 1.15rem; }
  .proj-meta { margin: 0 0 0.4em; font-size: var(--fs-small); color: var(--text-faint); }
  .proj-sum { margin: 0 0 0.6em; color: var(--text-muted); font-size: var(--fs-small); }
  .proj-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1rem; }
  .proj-links { margin-left: auto; display: inline-flex; gap: 0.8rem; font-size: var(--fs-small); font-weight: 600; }

  /* ---------- Awards ---------- */
  .awards { list-style: none; padding: 0; margin: 0; }
  .awards li { padding: 0.7rem 0; border-bottom: 1px solid var(--hairline); }
  .awards li:last-child { border-bottom: none; }
  .award-year { color: var(--text-faint); font-variant-numeric: tabular-nums; margin-right: 0.8rem; font-size: var(--fs-small); }
  .award-org { color: var(--text-muted); }

  /* ---------- Beyond ---------- */
  .beyond-grid { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .beyond-card {
    position: relative; display: flex; flex-direction: column; justify-content: flex-end;
    min-height: 180px; padding: 1.2rem; border-radius: var(--radius);
    border: 1px solid var(--border); background: var(--bg-elevated);
    overflow: hidden; color: var(--text); transition: transform 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .beyond-card:hover { transform: translateY(-3px); border-color: var(--accent); text-decoration: none; }
  .beyond-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .beyond-card:hover img { transform: scale(1.04); }
  .beyond-card img ~ .beyond-label { position: relative; color: #fff; text-shadow: 0 1px 8px rgba(0,0,0,0.6); }
  .beyond-card:has(img)::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 40%, rgba(0,0,0,0.55)); }
  .beyond-card .beyond-label { position: relative; font-weight: 600; font-size: var(--fs-small); z-index: 1; }
  .beyond-band { justify-content: space-between; align-items: stretch; gap: 0.3rem; background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 30%, transparent); }
  .beyond-band-link { display: flex; flex-direction: column; gap: 0.25rem; color: inherit; }
  .beyond-band-link:hover { text-decoration: none; }
  .beyond-band-name { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 600; color: var(--accent-ink); }
  .band-streams { display: inline-flex; gap: 1rem; margin-top: 0.9rem; }
  .band-streams a { font-size: 0.78rem; letter-spacing: 0.05em; color: var(--accent-ink); }
  .band-streams a:hover { color: var(--accent-strong); text-decoration: none; }
  .beyond-note-title { font-weight: 600; margin-bottom: 0.3rem; }
</style>
