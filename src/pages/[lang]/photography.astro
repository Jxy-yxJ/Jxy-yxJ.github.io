---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImmersiveGallery from '../../components/ImmersiveGallery.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export const getStaticPaths = () => [
  { params: { lang: 'en' } },
  { params: { lang: 'zh' } },
];
const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const photos = (await getCollection('photography'))
  .filter((p) => p.id.startsWith(lang + '/'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={t.photographyTitle} lang={lang} immersive={true}>
  {photos.length > 0 ? (
    <ImmersiveGallery photos={photos} lang={lang} />
  ) : (
    <header class="photo-head">
      <h1>{t.photographyTitle}</h1>
      <p class="lead" style="color:rgba(236,229,219,0.65)">
        {lang === 'zh' ? '作品待上传——可在后台 CMS 添加，图片会存到 public/photography。' : 'Photos coming soon — add them via the CMS; images land in public/photography.'}
      </p>
    </header>
  )}
</BaseLayout>

<style>
  .photo-head { padding: 3rem 0; }
</style>
