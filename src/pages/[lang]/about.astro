---
import PageLayout from '../../layouts/PageLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';
import { SITE } from '../../consts';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export const getStaticPaths = () => [
  { params: { lang: 'en' } },
  { params: { lang: 'zh' } },
];
const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const zh = lang === 'zh';

const education = (await getCollection('education'))
  .filter((i) => i.id.startsWith(lang + '/'))
  .sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('research'))
  .filter((i) => i.id.startsWith(lang + '/'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const focus = zh
  ? [
      ['机器人感知与操作', 'RGB-D、姿态/深度、运动规划'],
      ['医疗机器人', '带安全约束的自主任务执行'],
      ['具身智能体', '记忆、核验与评估'],
      ['仿真到现实', '面向操作与移动机器人的迁移'],
    ]
  : [
      ['Robotic perception & manipulation', 'RGB-D, pose/depth, motion planning'],
      ['Medical robotics', 'autonomous task execution under safety constraints'],
      ['Embodied agents', 'memory, verification, and evaluation'],
      ['Sim-to-real', 'transfer for manipulation and mobile robots'],
    ];

const skillGroups = zh
  ? [
      ['编程', 'Python · Git / GitHub Actions · Linux'],
      ['机器人与仿真', 'NVIDIA Isaac Sim · AI2-THOR · UR3 + Lula IK'],
      ['感知与机器学习', 'RGB-D · MediaPipe · OpenCV · PyTorch · Transformers · NumPy'],
      ['Web', 'Astro · TypeScript'],
    ]
  : [
      ['Programming', 'Python · Git / GitHub Actions · Linux'],
      ['Robotics & simulation', 'NVIDIA Isaac Sim · AI2-THOR · UR3 + Lula IK'],
      ['Perception & ML', 'RGB-D · MediaPipe · OpenCV · PyTorch · Transformers · NumPy'],
      ['Web', 'Astro · TypeScript'],
    ];

const lead = zh
  ? '我是江鑫宇，一名本科生，方向是具身智能——让机器能够感知、推理并在真实世界中行动。我目前的工作是仿真中的医疗操作：从 RGB-D 感知患者、定位临床目标，并规划机器人能安全执行、带碰撞约束的运动。'
  : 'I’m Xinyu Jiang, an undergraduate working toward embodied AI — teaching machines to perceive, reason, and act in the physical world. My current work is medical manipulation in simulation: perceiving a patient from RGB-D data, localizing a clinical target, and planning collision-aware motion a robot can execute safely.';
---

<PageLayout title={t.aboutTitle} lang={lang} wide description={zh ? SITE.taglineZh : SITE.taglineEn}>
  <div class="about-layout">
    <aside class="about-aside">
      <div class="aside-block">
        <p class="k">{zh ? '所在地' : 'Based in'}</p>
        <p class="v">{zh ? '中国 · 杭州' : 'Hangzhou, China'}</p>
      </div>
      <div class="aside-block">
        <p class="k">{zh ? '方向' : 'Focus'}</p>
        <p class="v">{zh ? '机器人感知与操作' : 'Robotic perception & manipulation'}</p>
      </div>
      <div class="aside-block">
        <p class="k">{zh ? '在读' : 'Currently'}</p>
        <p class="v">{zh ? '杭州电子科技大学 · 智能科学与技术（2023–2027）' : 'B.S. Intelligent Science & Technology, HDU (2023–2027)'}</p>
      </div>
      <div class="aside-block">
        <p class="k">{zh ? '联系' : 'Contact'}</p>
        <p class="v aside-links">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={SITE.social.github} target="_blank" rel="noopener">GitHub</a>
          <a href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={getRelativeLocaleUrl(lang, 'cv')}>CV</a>
        </p>
      </div>
    </aside>

    <div class="about-main">
      <p class="about-lead">{lead}</p>

      <section class="sec">
        <div class="sec-head"><span class="sec-idx">01</span><h2 class="sec-title">{zh ? '研究兴趣' : 'Focus'}</h2></div>
        <ul class="focus-list">
          {focus.map(([title, desc], i) => (
            <li>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">{title}<span class="d"> — {desc}</span></span>
            </li>
          ))}
        </ul>
      </section>

      <section class="sec">
        <div class="sec-head"><span class="sec-idx">02</span><h2 class="sec-title">{t.sections.education}</h2></div>
        {education.map((e) => (
          <div class="edu">
            <div class="edu-head">
              <span class="edu-degree">{e.data.degree}</span>
              <span class="edu-period">{e.data.period}</span>
            </div>
            <p class="edu-school">{e.data.school}</p>
            {e.data.details.length > 0 && (
              <ul class="edu-details">{e.data.details.map((d) => <li>{d}</li>)}</ul>
            )}
          </div>
        ))}
      </section>

      <section class="sec">
        <div class="sec-head"><span class="sec-idx">03</span><h2 class="sec-title">{zh ? '代表项目' : 'Selected work'}</h2></div>
        <ul class="work-list">
          {projects.map((p) => (
            <li>
              <a class="work" href={p.data.links.page ?? p.data.links.code}>
                <span class="work-title">{p.data.title}</span>
                {p.data.highlights[0] && <span class="work-metric">{p.data.highlights[0]}</span>}
                <span class="work-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="text-link" href={getRelativeLocaleUrl(lang, 'research')}>{t.viewAll} →</a>
      </section>

      <section class="sec">
        <div class="sec-head"><span class="sec-idx">04</span><h2 class="sec-title">{zh ? '技能' : 'Skills'}</h2></div>
        <dl class="skills">
          {skillGroups.map(([label, items]) => (
            <>
              <dt>{label}</dt>
              <dd>{items}</dd>
            </>
          ))}
        </dl>
      </section>

      <section class="sec">
        <div class="sec-head"><span class="sec-idx">05</span><h2 class="sec-title">{zh ? '工作之外' : 'Beyond work'}</h2></div>
        <div class="beyond">
          <a class="beyond-item" href={getRelativeLocaleUrl(lang, 'photography')}>
            <span class="beyond-title">{t.nav.photography}</span>
            <span class="beyond-desc">{zh ? '记录机器人将要进入的世界' : 'Documenting the world robots will act in'}</span>
          </a>
          <div class="beyond-item">
            <span class="beyond-title">{zh ? SITE.band.name : SITE.band.nameEn}</span>
            <span class="beyond-desc">{zh ? `独立乐队 · ${SITE.band.roleZh}` : `Indie band · ${SITE.band.roleEn}`}</span>
            <span class="beyond-links">
              <a href={SITE.band.netease} target="_blank" rel="noopener">NetEase</a>
              <a href={SITE.band.spotify} target="_blank" rel="noopener">Spotify</a>
            </span>
          </div>
        </div>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .about-layout {
    display: grid;
    grid-template-columns: 15.5rem minmax(0, 1fr);
    gap: 4.5rem;
    align-items: start;
  }
  .about-aside { position: sticky; top: 5.2rem; display: grid; gap: 1.5rem; }
  .aside-block .k {
    margin: 0 0 0.35rem; font-size: 0.7rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--text-faint);
  }
  .aside-block .v { margin: 0; font-size: 0.95rem; color: var(--text); line-height: 1.5; }
  .aside-links { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; }
  .aside-links a { color: var(--text-muted); font-size: 0.9rem; }
  .aside-links a:hover { color: var(--accent); }

  .about-lead {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    line-height: 1.5; letter-spacing: -0.012em;
    margin: 0 0 3rem; max-width: 46ch; color: var(--text);
  }

  .sec { padding: 2.3rem 0; border-top: 1px solid var(--hairline); }
  .sec-head { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1.3rem; }
  .sec-idx { font-size: 0.8rem; color: var(--accent); font-variant-numeric: tabular-nums; }
  .sec-title { margin: 0; font-size: clamp(1.3rem, 2.2vw, 1.55rem); }

  .focus-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }
  .focus-list li { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); gap: 1rem; align-items: baseline; }
  .focus-list .n { color: var(--accent); font-size: 0.82rem; font-variant-numeric: tabular-nums; }
  .focus-list .t { color: var(--text); }
  .focus-list .d { color: var(--text-muted); }

  .edu-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .edu-degree { font-weight: 600; }
  .edu-period { color: var(--text-faint); font-size: 0.85rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .edu-school { margin: 0.2rem 0 0.7rem; color: var(--text-muted); }
  .edu-details { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .edu-details li { position: relative; padding-left: 1.1rem; color: var(--text-muted); font-size: 0.92rem; }
  .edu-details li::before { content: '—'; position: absolute; left: 0; color: var(--accent); }

  .work-list { list-style: none; margin: 0 0 1.2rem; padding: 0; }
  .work {
    display: grid; grid-template-columns: minmax(0, 1fr) 1.2rem;
    grid-template-areas: 'title arrow' 'metric arrow';
    gap: 0.3rem 1rem; align-items: start; padding: 1rem 0;
    border-bottom: 1px solid var(--hairline); color: var(--text);
  }
  .work:hover { text-decoration: none; }
  .work:hover .work-title { color: var(--accent-strong); }
  .work:hover .work-arrow { transform: translateX(3px); }
  .work-title { grid-area: title; font-family: var(--font-serif); font-size: 1.12rem; transition: color 0.2s var(--ease); }
  .work-metric { grid-area: metric; color: var(--text-faint); font-size: 0.84rem; }
  .work-arrow { grid-area: arrow; align-self: center; color: var(--accent); transition: transform 0.2s var(--ease); }
  .text-link { font-weight: 600; font-size: 0.85rem; }

  .skills { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 0.8rem 1.5rem; margin: 0; }
  .skills dt { color: var(--text-faint); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .skills dd { margin: 0; color: var(--text-muted); }

  .beyond { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .beyond-item {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: 1.2rem; border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg-elevated); color: var(--text);
  }
  a.beyond-item:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); text-decoration: none; }
  .beyond-title { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 600; }
  .beyond-desc { color: var(--text-muted); font-size: 0.9rem; }
  .beyond-links { display: inline-flex; gap: 1rem; margin-top: 0.4rem; }
  .beyond-links a { font-size: 0.8rem; letter-spacing: 0.04em; color: var(--accent-ink); }
  .beyond-links a:hover { color: var(--accent-strong); }

  @media (max-width: 900px) {
    .about-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .about-aside { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem 1.5rem; }
    .skills { grid-template-columns: 1fr; gap: 0.2rem 0; }
    .skills dt { margin-top: 0.8rem; }
    .beyond { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .about-aside { grid-template-columns: 1fr; }
    .work { grid-template-areas: 'title arrow'; }
    .work-metric { display: none; }
  }
</style>
