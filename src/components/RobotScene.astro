---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
---

<div class:list={['robot-scene', className]} data-robot-scene aria-hidden="true">
  <div class="robot-vignette"></div>
  <div class="robot-fallback">
    <!-- 静态降级插画（无 WebGL / 加载失败时显示） -->
    <svg viewBox="0 0 360 220" width="360" height="220" role="img" aria-label={t.hero.robotAlt}>
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" opacity="0.55">
        <!-- 机械臂 -->
        <path d="M40 190 L40 150" />
        <circle cx="40" cy="196" r="10" />
        <path d="M40 150 L92 120" />
        <circle cx="92" cy="120" r="7" />
        <path d="M92 120 L150 138" />
        <circle cx="150" cy="138" r="6" />
        <path d="M150 138 L180 150" />
        <!-- 人形 -->
        <rect x="256" y="96" width="52" height="58" rx="14" />
        <rect x="268" y="62" width="28" height="26" rx="9" />
        <path d="M264 154 L262 200 M300 154 L302 200" />
        <path d="M256 110 L238 140 M308 110 L326 140" />
        <circle cx="279" cy="90" r="14" />
        <!-- 小机器人 -->
        <rect x="180" y="158" width="44" height="34" rx="12" />
        <path d="M188 158 L188 142 M216 158 L216 142" />
        <circle cx="188" cy="138" r="6" />
        <circle cx="216" cy="138" r="6" />
      </g>
      <g fill="currentColor" opacity="0.35">
        <circle cx="279" cy="90" r="3" />
        <circle cx="188" cy="138" r="2" />
        <circle cx="216" cy="138" r="2" />
      </g>
    </svg>
  </div>
</div>

<script>
  const el = document.querySelector('[data-robot-scene]') as HTMLElement | null;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el) {
    const io = new IntersectionObserver(
      async ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        try {
          const { initRobots } = await import('../scripts/robot-scene');
          await initRobots(el, { reduced });
        } catch {
          el.classList.add('robot-failed');
        }
      },
      { rootMargin: '300px' }
    );
    io.observe(el);
  }
</script>

<style>
  .robot-scene {
    position: relative; width: 100%; height: 100%; min-height: 320px;
    color: var(--text);
    touch-action: pan-y;
  }
  .robot-scene canvas { display: block; width: 100% !important; height: 100% !important; outline: none; }
  .robot-vignette {
    position: absolute; inset: -10%; pointer-events: none; z-index: 2;
    background: radial-gradient(68% 62% at 50% 44%, transparent 40%, color-mix(in srgb, var(--bg) 55%, transparent) 100%);
  }
  .robot-fallback { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; z-index: 1; }
  .robot-failed .robot-fallback { display: flex; }
</style>
