---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Nav from './Nav.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../consts';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  immersive?: boolean;
}
const { lang, immersive = false } = Astro.props;
const home = getRelativeLocaleUrl(lang, '/');
---

<header class="site-header" data-site-header>
  <div class="container bar">
    <a class="brand" href={home}>
      <span class="brand-mark">XJ</span>
      <span class="brand-name">{SITE.author}</span>
    </a>

    <div class="nav-wrap" data-nav-wrap>
      <Nav lang={lang} immersive={immersive} />
      <div class="actions">
        <LangSwitch lang={lang} />
        <ThemeToggle lang={lang} />
      </div>
    </div>

    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-label="Menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]') as HTMLElement | null;
  const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
    header.querySelectorAll('.nav-wrap a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    matchMedia('(min-width: 881px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(150%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.62rem;
    position: relative;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
    color: var(--text);
    white-space: nowrap;
  }
  .brand:hover { color: var(--text); text-decoration: none; }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 1.7rem; height: 1.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent-strong);
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .brand:hover .brand-mark { border-color: var(--accent); }
  .brand-name { font-size: 0.98rem; }

  .nav-wrap {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-left: auto;
  }
  .actions { display: inline-flex; align-items: center; gap: 0.5rem; }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    width: 40px; height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    padding: 0;
    position: relative;
  }
  .menu-toggle span {
    position: absolute; left: 50%; transform: translateX(-50%);
    width: 16px; height: 1.5px; background: var(--text);
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease), top 0.3s var(--ease);
  }
  .menu-toggle span:nth-child(1) { top: 15px; }
  .menu-toggle span:nth-child(2) { top: 22px; }
  [data-open] .menu-toggle span:nth-child(1) { top: 19px; transform: translateX(-50%) rotate(45deg); }
  [data-open] .menu-toggle span:nth-child(2) { top: 19px; transform: translateX(-50%) rotate(-45deg); }

  @media (min-width: 881px) {
    .menu-toggle { display: none; }
  }

  @media (max-width: 880px) {
    .nav-wrap {
      position: absolute;
      top: calc(100% + 1px);
      left: 0; right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0;
      padding: 0.5rem 1.5rem 1.1rem;
      background: var(--bg-elevated);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
      display: none;
    }
    [data-open] .nav-wrap { display: flex; }
    .actions { margin-top: 0.7rem; }
  }
</style>
