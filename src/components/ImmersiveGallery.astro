---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  photos: CollectionEntry<'photography'>[];
  lang: Lang;
}
const { photos, lang } = Astro.props;
const t = useTranslations(lang);
const [hero, ...rest] = photos;

function plainCaption(p: CollectionEntry<'photography'>) {
  return [
    p.data.title,
    [p.data.location, p.data.camera, p.data.date?.toISOString().slice(0, 10)].filter(Boolean).join(' · '),
    p.data.description,
  ]
    .filter(Boolean)
    .join('<br>');
}
const pswpAttrs = (p: CollectionEntry<'photography'>) => ({
  'data-pswp-width': p.data.width ?? 1600,
  'data-pswp-height': p.data.height ?? 1067,
  'data-caption': plainCaption(p),
});
---

<div id="pswp-gallery">
  {hero && (
    <a class="ig-hero" href={hero.data.image} {...pswpAttrs(hero)}>
      <img src={hero.data.image} alt={hero.data.title} />
      <span class="ig-veil" aria-hidden="true"></span>
      <span class="ig-hero-text">
        <span class="ig-eyebrow">{lang === 'zh' ? '摄影集' : 'Photography'}</span>
        <span class="ig-hero-title">{t.photographyTitle}</span>
        <span class="ig-hint">{lang === 'zh' ? '点击查看大图与拍摄笔记' : 'Click a photo for the full view and field notes'}</span>
      </span>
    </a>
  )}

  <div class="ig-grid">
    {rest.map((p) => (
      <a class="ig-item" href={p.data.image} {...pswpAttrs(p)}>
        <img src={p.data.image} alt={p.data.title} width={p.data.width} height={p.data.height} loading="lazy" decoding="async" />
        <span class="ig-cap">
          <span class="ig-title">{p.data.title}</span>
          <span class="ig-meta">
            {[p.data.location, p.data.camera].filter(Boolean).join(' · ')}
            {p.data.date && <span class="ig-date"><FormattedDate date={p.data.date} lang={lang} /></span>}
          </span>
        </span>
      </a>
    ))}
  </div>
</div>

<script>
  import '../scripts/photoswipe';
</script>

<style>
  #pswp-gallery { display: block; }

  /* ---------- Hero ---------- */
  .ig-hero {
    position: relative; display: block;
    width: 100vw; margin-left: calc(50% - 50vw);
    height: 94svh; overflow: hidden; color: #fff;
  }
  .ig-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 8s var(--ease); }
  .ig-hero:hover img { transform: scale(1.03); }
  .ig-veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11,12,14,0.15) 38%, rgba(11,12,14,0.82) 100%); }
  .ig-hero-text { position: absolute; left: clamp(1.25rem, 6vw, 5rem); right: clamp(1.25rem, 6vw, 5rem); bottom: 9vh; display: flex; flex-direction: column; gap: 0.5rem; }
  .ig-eyebrow { font-size: 0.72rem; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(243,240,234,0.85); }
  .ig-hero-title { font-family: var(--font-serif); font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 600; line-height: 1; }
  .ig-hint { font-size: 0.85rem; color: rgba(243,240,234,0.7); }

  /* ---------- Masonry grid ---------- */
  .ig-grid {
    columns: 3 300px;
    column-gap: 1.3rem;
    padding: clamp(3rem, 8vh, 6rem) 0;
  }
  .ig-item {
    display: block; break-inside: avoid; margin: 0 0 1.6rem;
    color: #ece9e3;
  }
  .ig-item img {
    display: block; width: 100%; height: auto; border-radius: 6px;
    box-shadow: 0 14px 44px rgba(0,0,0,0.4);
    transition: transform 0.6s var(--ease), filter 0.3s var(--ease);
  }
  .ig-item:hover { text-decoration: none; }
  .ig-item:hover img { transform: translateY(-2px); filter: brightness(1.04); }
  .ig-cap { display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.7rem; }
  .ig-title { font-family: var(--font-serif); font-size: 1rem; color: #fff; transition: color 0.2s var(--ease); }
  .ig-item:hover .ig-title { color: var(--accent); }
  .ig-meta {
    display: flex; flex-wrap: wrap; gap: 0.2rem 0.8rem;
    font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: rgba(236,233,227,0.55);
  }
  .ig-date { font-variant-numeric: tabular-nums; }

  @media (prefers-reduced-motion: reduce) {
    .ig-hero img, .ig-item img { transition: none; }
  }
</style>
