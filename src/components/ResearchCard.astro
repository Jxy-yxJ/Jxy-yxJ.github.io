---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';

interface Props {
  item: CollectionEntry<'research'>;
  index: number;
  lang: Lang;
}
const { item, index, lang } = Astro.props;
const { title, role, period, summary, tags, links, highlights, cover } = item.data;
const isInternal = (url: string) => url.startsWith('https://Jxy-yxJ.github.io/');
const href = (url: string) => (isInternal(url) ? new URL(url).pathname : url);
const primary = links.page || links.code;
const labels = { project: 'Project', code: 'Code', paper: 'Paper', demo: 'Demo' };
---

<article class="entry">
  <div class="entry-rail">
    <span class="idx">{String(index).padStart(2, '0')}</span>
    {period && <span class="period">{period}</span>}
  </div>

  <div class="entry-body">
    <p class="role">{role}</p>
    <h3 class="title">{title}</h3>
    <p class="summary">{summary}</p>

    {highlights.length > 0 && (
      <ul class="points">
        {highlights.map((h) => <li>{h}</li>)}
      </ul>
    )}

    <div class="foot">
      {tags.length > 0 && (
        <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
      )}
      <nav class="links" aria-label="Links">
        {links.page && <a class="link" href={href(links.page)}>Project <span aria-hidden="true">→</span></a>}
        {links.code && <a class="link" href={links.code} target="_blank" rel="noopener">Code <span aria-hidden="true">↗</span></a>}
        {links.paper && <a class="link" href={links.paper} target="_blank" rel="noopener">Paper <span aria-hidden="true">↗</span></a>}
        {links.demo && <a class="link" href={links.demo} target="_blank" rel="noopener">Demo <span aria-hidden="true">↗</span></a>}
      </nav>
    </div>
  </div>

  {cover && (
    <a class="cover" href={primary ? href(primary) : undefined} target={primary && !isInternal(primary) ? '_blank' : undefined} rel="noopener" aria-hidden="true" tabindex="-1">
      <img src={cover} alt="" loading="lazy" />
    </a>
  )}
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) 232px;
    gap: 2.2rem;
    padding: 2.4rem 0;
    border-top: 1px solid var(--hairline);
    align-items: start;
  }
  .entry-rail { display: flex; flex-direction: column; gap: 0.5rem; padding-top: 0.35rem; }
  .idx {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: var(--accent);
  }
  .period { font-size: 0.78rem; color: var(--text-faint); letter-spacing: 0.02em; }

  .role {
    margin: 0 0 0.5rem;
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .title { margin: 0 0 0.6rem; font-size: clamp(1.3rem, 2.4vw, 1.7rem); letter-spacing: -0.015em; }
  .summary { margin: 0 0 1rem; color: var(--text-muted); max-width: 60ch; }

  .points { list-style: none; margin: 0 0 1.2rem; padding: 0; display: grid; gap: 0.45rem; }
  .points li { position: relative; padding-left: 1.1rem; color: var(--text-muted); font-size: 0.95rem; }
  .points li::before { content: '—'; position: absolute; left: 0; color: var(--accent); }

  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.4rem; }
  .tags { display: inline-flex; flex-wrap: wrap; gap: 0.35rem; }
  .links { display: inline-flex; gap: 1.1rem; margin-left: auto; }
  .link {
    font-size: 0.82rem; font-weight: 600; letter-spacing: 0.03em;
    color: var(--accent-strong);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .link:hover { color: var(--accent); border-bottom-color: var(--accent); text-decoration: none; }

  .cover {
    display: block; border: 1px solid var(--border); border-radius: var(--radius);
    overflow: hidden; background: var(--bg-subtle);
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .cover img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform 0.6s var(--ease); }
  .cover:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); transform: translateY(-2px); }
  .cover:hover img { transform: scale(1.03); }

  @media (max-width: 900px) {
    .entry { grid-template-columns: 3rem minmax(0, 1fr); gap: 1.2rem; padding: 1.9rem 0; }
    .entry-rail { grid-row: span 2; }
    .cover { grid-column: 2 / 3; }
    .cover img { aspect-ratio: 16 / 9; }
  }
</style>
