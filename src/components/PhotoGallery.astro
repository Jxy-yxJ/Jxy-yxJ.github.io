---
import type { CollectionEntry } from 'astro:content';

interface Props {
  photos: CollectionEntry<'photography'>[];
}
const { photos } = Astro.props;

function captionFor(p: CollectionEntry<'photography'>) {
  return [
    p.data.title,
    p.data.location && `📍 ${p.data.location}`,
    p.data.camera && `📷 ${p.data.camera}`,
    p.data.date && `🗓 ${p.data.date.toISOString().slice(0, 10)}`,
    p.data.description,
  ]
    .filter(Boolean)
    .join('<br>');
}
---

<section class="gallery" id="pswp-gallery">
  {photos.map((p) => (
    <a
      class="photo"
      href={p.data.image}
      target="_blank"
      rel="noopener"
      data-pswp-width={p.data.width ?? 1600}
      data-pswp-height={p.data.height ?? 1067}
      data-caption={captionFor(p)}
    >
      <img src={p.data.image} alt={p.data.title} loading="lazy" />
      <span class="cap">{p.data.title}{p.data.location && ` · ${p.data.location}`}</span>
    </a>
  ))}
</section>

<script>
  import '../scripts/photoswipe';
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.8rem;
    margin-top: 1.5rem;
  }
  .photo {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-elevated);
  }
  .photo img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .photo:hover img { transform: scale(1.04); }
  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.6rem 0.8rem;
    font-size: 0.85rem;
    color: #fff;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .photo:hover .cap { opacity: 1; }
</style>
