---
import { SITE } from '../consts';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
const links = [
  { label: 'GitHub', href: SITE.social.github },
  { label: 'LinkedIn', href: SITE.social.linkedin },
  { label: 'Scholar', href: SITE.social.scholar },
  { label: 'Email', href: `mailto:${SITE.email}` },
].filter((l) => l.href);
---

<footer class="site-footer">
  <div class="container foot">
    <p>© {year} {SITE.author}. {lang === 'zh' ? '保留所有权利。' : 'All rights reserved.'}</p>
    <ul class="social">
      {links.map((l) => (
        <li><a href={l.href} rel="me noopener" target="_blank">{l.label}</a></li>
      ))}
    </ul>
    <p class="band-line">
      <span class="band-name">{lang === 'zh' ? SITE.band.name : SITE.band.nameEn}</span>
      <a href={SITE.band.netease} target="_blank" rel="noopener">NetEase</a>
      <a href={SITE.band.spotify} target="_blank" rel="noopener">Spotify</a>
    </p>
  </div>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }
  .social {
    list-style: none;
    display: flex;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .social a { color: var(--text-muted); font-size: 0.9rem; }
  .social a:hover { color: var(--accent); }
  .band-line {
    display: inline-flex; align-items: center; gap: 0.7rem;
    margin: 0; font-size: 0.85rem;
  }
  .band-name { color: var(--text-muted); font-style: italic; font-family: var(--font-serif); }
  .band-line a { color: var(--text-faint); font-size: 0.8rem; letter-spacing: 0.04em; }
  .band-line a:hover { color: var(--accent); }
</style>
