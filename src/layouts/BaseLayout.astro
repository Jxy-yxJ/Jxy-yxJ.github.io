---
import BaseHead from './BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  lang: string;
  image?: string;
  immersive?: boolean; // 摄影页沉浸暗底
}

const { title, description, lang, image, immersive = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} lang={lang} image={image} />
  </head>
  <body class={immersive ? 'immersive' : ''}>
    <Header lang={lang} immersive={immersive} />
    <main class="container" class:list={[{ 'container-wide': immersive }]}>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
