---
import BaseLayout from './BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import { SITE } from '../consts';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  lang: Lang;
  description?: string;
  intro?: string;
  immersive?: boolean;
  wide?: boolean;
}

const { title, lang, description, intro, immersive = false, wide = false } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout title={`${title} · ${SITE.author}`} description={description} lang={lang} immersive={immersive}>
  <header class="page-head">
    <h1>{title}</h1>
    {intro && <p class="lead">{intro}</p>}
  </header>
  <div class:list={['prose', { 'prose--wide': wide }]}>
    <slot />
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: 3rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .lead {
    color: var(--text-muted);
    font-size: 1.15rem;
    max-width: 60ch;
  }
  .prose--wide { max-width: none; }
</style>
